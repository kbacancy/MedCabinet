{
  "expo": {
    "name": "MedCabinet",
    "slug": "MedCabinet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medcabinet",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan medicine barcodes",
        "NSPhotoLibraryUsageDescription": "Used to pick medicine photos",
        "NSSpeechRecognitionUsageDescription": "Used to enter medicine names and dosages by voice",
        "NSMicrophoneUsageDescription": "Used for voice-to-text input in medicine forms"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedCabinet to access your camera to scan medicine barcodes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D9E75"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow MedCabinet to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow MedCabinet to use speech recognition for voice-to-text."
        }
      ]
    ]
  }
}
